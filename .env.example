# Required
ANTHROPIC_API_KEY=your-api-key-here

# Optional — raises GitHub API rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=

# Optional — override default data directory (~/.linkwiki)
LINKWIKI_DATA_DIR=

# Optional — logging configuration
# Directory where log files are written (default: logs/ relative to working directory)
LINKWIKI_LOG_DIR=logs
# Minimum log level written to linkwiki.jsonl: DEBUG | INFO | WARNING | ERROR (default: INFO)
# errors.jsonl always captures ERROR and above regardless of this setting
LINKWIKI_LOG_LEVEL=INFO
